# Voltora Backend Environment Variables
SECRET_KEY=voltora-production-secret-key-change-in-prod-xyz123
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver,*

# Database (SQLite in development)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_sample_key_12345
RAZORPAY_KEY_SECRET=sample_razorpay_secret_67890
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret_abcde

# Platform Settings
SELLER_COMMISSION_PERCENT=10.0
DEFAULT_CITY=Hyderabad
